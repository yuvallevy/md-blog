{
    "name": "yuvallevy/blog",
    "description": "Yuval Levy's software blog",
    "require": {
        "php": "^8.3",
        "league/commonmark": "^2.6",
        "symfony/yaml": "^7.4",
        "tempest/highlight": ">=2.6,<2.13"
    },
    "autoload": {
        "psr-4": {
            "Blog\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
